# Copy to `.env`. Never commit real `.env` files.

# Optional: comma-separated allowed browser origins. If unset, any origin is allowed (reflected).
# Example: CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Use * in app code only via omitting this var — see server.mjs
# CORS_ORIGINS=

# --- Email OTP (staff + student signup verify-email-otp) ---
# When email delivery is broken or you need a fixed code (e.g. staging), set this to a 6-digit string.
# Users must still click "send code" first; they can then enter this value instead of the email.
# Remove or leave unset in production once real OTP email works.
# EMAIL_OTP_STATIC_CODE=000000
